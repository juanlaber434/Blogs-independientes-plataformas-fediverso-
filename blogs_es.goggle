$boost=3,site=mystrikingly.com
$boost=3,site=site123.me
$boost=3,site=ghost.io
$boost=3,site=hashnode.dev
!
! Dominio .blog completo (sintaxis de TLD como el ejemplo ".edu" de Brave; no verificado)
$boost=3,site=.blog
!
